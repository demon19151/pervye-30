flowchart TD
    A[Пользователь] --> B1[Изменение настроек группы]
    A --> B2[Добавление мероприятия]
    A --> B3[Просмотр настроения и энергии участников]
    A --> B4[Добавление задания участникам]
    A --> B5[Создание группы и добавление участников]
    A --> B6[Просмотр информации о выполненной работе]
    A --> B7[Оценка энергии и настроения]
    A --> B8[Просмотр информации о группе и прогрессе]
    A --> B9[Просмотр списка заданий от куратора]
    A --> B10[Просмотр расписания и мероприятий]

    %% Блоки логики
    B1 --> L1[Проверка прав доступа и корректности данных]
    L1 --> D1[Обновление полей в БД]

    B2 --> L2[Проверка пересечений по времени и вместимости]
    L2 --> D2[Сохранение мероприятия с привязкой к дате, группе, типу]

    B3 --> L3[Объединение данных из ежедневных вопросов]
    L3 --> L3a[Нормализация шкалы оценок]

    B4 --> L4[Проверка даты, типа задания, привязки к группе]
    L4 --> D4[Сохранение задания + установка уведомлений]

    B5 --> L5[Проверка уникальности названия и прав куратора]
    L5 --> D5[Сохранение группы и привязка участников]

    B6 --> L6[Фильтрация заданий по статусу "Выполнено" за период]
    L6 --> L6a[Формирование текстовой сводки]

    B7 --> L7[Проверка: была ли оценка за сегодня]
    L7 --> L7a[Фильтрация введённых значений]
    L7a --> D7[Сохранение оценки + заметки]

    B8 --> L8[Определение группы пользователя]
    L8 --> L8a[Расчёт общего прогресса]

    B9 --> L9[Проверка принадлежности к группе]
    L9 --> L9a[Поиск активных заданий куратора]

    B10 --> L10[Определение текущей даты]
    L10 --> L10a[Фильтрация мероприятий по дате и группе]

    %% Результаты (что возвращается на экран)
    D1 --> R1[Обновлённые данные группы + уведомление]
    D2 --> R2[Список мероприятий на день + статус добавления]
    L3a --> R3[Графики настроения + индивидуальные карточки]
    D4 --> R4[Карточка задания в расписании с датой]
    D5 --> R5[Список участников по ролям]
    L6a --> R6[Текстовый отчёт / "Нет данных"]
    D7 --> R7[Шкалы настроения/энергии + поле для заметки]
    L8a --> R8[Данные о группе + визуализированный прогресс]
    L9a --> R9[Карточка задания дня / статус "Выполнено" / "Нет задания"]
    L10a --> R10[Список мероприятий на день / "Нет мероприятий"]

    %% Связи результатов с пользователем (отображение)
    R1 --> A
    R2 --> A
    R3 --> A
    R4 --> A
    R5 --> A
    R6 --> A
    R7 --> A
    R8 --> A
    R9 --> A
    R10 --> A